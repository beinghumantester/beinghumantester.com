---
import { THEME_CONFIG } from "../../config";
import Icon from "../ui/Icon.astro";

const currentYear = new Date().getFullYear();
const showToggle = THEME_CONFIG.lightAndDark;
---

<footer class="footer">
    <div class="flex items-center gap-4">
        <span class="body-xs">&copy; {currentYear} Ujjwal Kumar Singh</span>
    </div>
    <div class="flex items-center gap-4">
        <span class="body-xs hidden sm:inline-block">Crafted with curiosity and testing mindset</span>
        <a
            href="/rss.xml"
            aria-label="RSS Feed"
            title="RSS Feed"
            target="_blank"
            rel="noreferrer"
            class="btn-icon"
        >
            <Icon name="RSS" size={16} />
        </a>
        {
            showToggle && (
                <button
                    id="theme-toggle"
                    aria-label="Toggle Dark Mode"
                    class="btn-icon"
                >
                    <Icon name="Sun" size={16} class="hidden dark:block" />
                    <Icon name="Moon" size={16} class="block dark:hidden" />
                </button>
            )
        }
    </div>
</footer>
