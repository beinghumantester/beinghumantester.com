---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Timeline from "../../components/ui/Timeline.astro";
import { PAGES } from "../../config";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
    throw new Error(
        "CV content not found. Please ensure src/content/cv.md exists.",
    );
}

const { Content } = await render(cvEntry);
const {
    name,
    title,
    label,
    email,
    location,
    summary,
    social_networks = [],
    experience = [],
    education = [],
    certificates = [],
    skills = [],
} = cvEntry.data;
---

<BaseLayout title={PAGES.cv.title}>
    <header class="page-header">
        <h1 class="page-title">{PAGES.cv.title}</h1>
        <p class="page-subtitle">{PAGES.cv.subtitle}</p>
    </header>

    <div class="container-narrow">
        <section class="section">
            <h2 class="title-lg">{name}</h2>
            {(label || title) && <p class="body font-semibold opacity-90">{label || title}</p>}
            <div class="body-sm mt-1" style="opacity: 0.75;">
                {[location, email].filter(Boolean).join(" · ")}
                {social_networks.filter(s => s.username).map(s => (
                    <>
                        {" · "}
                        <span>{s.network}: {s.username}</span>
                    </>
                ))}
            </div>
            {summary && <p class="body mt-4">{summary}</p>}
        </section>

        {
            experience.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Professional Experience
                    </h2>
                    <Timeline items={experience.map(exp => ({
                        title: exp.role,
                        subtitle: exp.institution,
                        period: exp.period,
                        description: exp.description,
                        highlights: exp.highlights
                    }))} />
                </section>
            )
        }

        {
            education.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Education
                    </h2>
                    <Timeline items={education.map(edu => ({
                        title: edu.degree,
                        subtitle: edu.institution,
                        period: edu.period,
                        description: edu.description,
                        thesis: edu.thesis
                    }))} />
                </section>
            )
        }

        {
            certificates.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Certificates
                    </h2>
                    <ul class="body" style="list-style: disc; padding-left: 1.25rem;">
                        {certificates.map(cert => (
                            <li>
                                {cert.name}
                                {cert.issuer && ` — ${cert.issuer}`}
                                {cert.date && ` (${cert.date})`}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            skills.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Skills
                    </h2>
                    {skills.map(skill => (
                        <div class="mt-3">
                            <div class="body font-semibold">
                                {skill.name}
                                {skill.level && <span class="body-sm opacity-60"> · {skill.level}</span>}
                            </div>
                            {skill.keywords && skill.keywords.length > 0 && (
                                <div class="mt-1" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                    {skill.keywords.map(keyword => (
                                        <span class="tag" style="cursor: default;">{keyword}</span>
                                    ))}
                                </div>
                            )}
                        </div>
                    ))}
                </section>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>
    </div>
</BaseLayout>

